{
  "name": "box-worker",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types",
    "clean": "rm -rf .wrangler",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply box --local",
    "db:migrate:remote": "wrangler d1 migrations apply box --remote",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:reset": "pnpm clean && pnpm db:migrate:local",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.0",
    "@elysiajs/openapi": "^1.4.11",
    "drizzle-orm": "^0.44.7",
    "elysia": "^1.4.16",
    "ulid": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/node": "^24.10.1",
    "drizzle-kit": "^0.31.7",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.47.0",
    "wrangler": "^4.50.0"
  }
}