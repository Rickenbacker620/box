{
  "name": "box-worker",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types",
    "clean": "rm -rf .wrangler",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply box --local",
    "db:migrate:remote": "wrangler d1 migrations apply box --remote",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:reset": "pnpm clean && pnpm db:migrate:local",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/openapi": "^1.4.13",
    "drizzle-orm": "^0.45.1",
    "elysia": "^1.4.19",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/node": "^25.0.3",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.51.0",
    "wrangler": "^4.54.0"
  }
}