{
  "name": "box-worker",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "clean": "rm -rf .wrangler",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply counter-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply counter-db --remote",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:reset": "pnpm clean && pnpm db:migrate:local",
    "db:seed:local": "wrangler d1 execute DB --local --file=./seed.sql",
    "db:seed:remote": "wrangler d1 execute DB --remote --file=./seed.sql"
  },
  "dependencies": {
    "@elysiajs/cors": "latest",
    "@elysiajs/openapi": "latest",
    "drizzle-orm": "latest",
    "elysia": "latest",
    "slugify": "^1.6.6",
    "ulid": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "drizzle-kit": "^0.31.6",
    "tsx": "^4.20.6",
    "wrangler": "^4.4.0"
  }
}