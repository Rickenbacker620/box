{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "box-worker",
	"main": "src/index.ts",
	"compatibility_date": "2025-11-11",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "box",
			"database_id": "3a3a875a-3638-4be9-8c4b-4488526f514f",
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "files"
		}
	]
}